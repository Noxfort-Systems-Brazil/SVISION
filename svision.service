# File: svision.service
# Author: Gabriel Moraes
# Date: 2026-10-06

[Unit]
Description=SVision Sovereign Edge AI Engine & Signal Orchestrator
After=network.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/svision-core
Environment=PYTHONUNBUFFERED=1
Environment=SVISION_ROOT=/opt/svision-core
ExecStart=/opt/svision-core/.venv/bin/python /opt/svision-core/svision.py --daemon
Restart=always
RestartSec=5s
LimitNOFILE=65536
KillMode=mixed
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
